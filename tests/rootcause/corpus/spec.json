      ],
      "id": "A1",
      "reason": "The accepted publishing-gap detector never evaluates silence at the end of a topic (only an interval between two captured messages), so a source that stops for good is invisible to M3c. The silent-source scenarios therefore use a bounded silence after which the source resumes. Made before any catalogue entry existed; the limit is recorded in the M4-0 record."
    }
  ],
  "answer_kinds": {
    "mechanism": "the true class must appear in the competing set of the set that covers the fault topic; a leader, if any, must be in acceptable_leaders",
    "no_failure": "nothing happened: there must be no hypothesis set and no leader",
    "unresolved": "the recording cannot decide: any 'leading' hypothesis is a confident wrong leader; the report must say unresolved or cannot be assessed"
  },
